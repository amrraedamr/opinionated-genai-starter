SERVICE_NAME=mcp_server
ENVIRONMENT=local
LOG_LEVEL=INFO
API_PREFIX=/api/mcp_server
RATE_LIMIT_BACKEND=memory
REQUEST_MAX_BYTES=1048576
TRUSTED_HOSTS=localhost,127.0.0.1

# MCP. Clients connect to <host><MCP_SERVER_PATH>/ with a bearer token this
# service can verify: the same tokens identity issues.
MCP_SERVER_ENABLED=true
MCP_SERVER_PATH=/mcp
AUTH_PUBLIC_KEY_PATH=keys/public.pem

# Tenancy is opt-in. When on, a tool runs for the tenant the caller's token names.
TENANCY_ENABLED=false
