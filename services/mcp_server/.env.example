SERVICE_NAME=mcp_server
ENVIRONMENT=local
LOG_LEVEL=INFO
API_PREFIX=/api/mcp_server
RATE_LIMIT_BACKEND=memory
REQUEST_MAX_BYTES=1048576
# Name every host a client reaches this by, such as its compose or cluster name.
TRUSTED_HOSTS=localhost,127.0.0.1

# MCP. Clients connect to <host><MCP_SERVER_PATH>/ with a bearer token this
# service can verify: the same tokens identity issues. Served stateless, so one
# client may send a different caller's token on each request.
MCP_SERVER_ENABLED=true
MCP_SERVER_PATH=/mcp
AUTH_PUBLIC_KEY_PATH=keys/public.pem

# Tenancy is opt-in. When on, a tool runs for the tenant the caller's token names.
TENANCY_ENABLED=false

# On, personal data is redacted from this service's logs and spans. Tool results
# are checked by the calling service, at its TOOL_RESULT stage, not here.
GUARDRAILS_ENABLED=false

# Tracing. Off unless OTEL_ENABLED is true.
OTEL_ENABLED=false
# OTEL_EXPORTER_ENDPOINT=http://localhost:4317
