# chat_api — copy to `.env` and fill in what you need.
#
# Layering, lowest priority first:
#   1. field defaults in CoreSettings / the mixins this service composes
#   2. ../../.env.shared   shared local infrastructure endpoints
#   3. ./.env              this service's own values — its database, its keys
#   4. ./.env.local        personal overrides, never committed
#   5. real process environment, which wins over all of the above
#
# Only the subsystems chat_api actually uses appear here. Mongo, Cosmos,
# Qdrant and Azure Search fields are absent because this service does not
# compose their settings mixins or install their extras.

# Identity — namespaces Redis channels, cache keys, logs and traces.
SERVICE_NAME=chat_api
ENVIRONMENT=local
LOG_LEVEL=INFO
API_PREFIX=/api/7r
MAX_GUNICORN_WORKERS=2

# Comma-separated. Empty means "* in local, nothing anywhere else".
# CORS_ORIGINS=http://localhost:3000

# Auth (JWT RS256). chat_api issues tokens today; after the identity split it
# only verifies them and AUTH_PRIVATE_KEY_PATH moves to that service.
AUTH_PRIVATE_KEY_PATH=keys/private.pem
AUTH_PUBLIC_KEY_PATH=keys/public.pem
ACCESS_TOKEN_EXPIRY_SECONDS=900
REFRESH_TOKEN_EXPIRY_SECONDS=604800

# OAuth / Login-with-X (comma-separated: google,facebook,microsoft,github,apple)
# OAUTH_PROVIDERS=google
# OAUTH_SUCCESS_REDIRECT=http://localhost:3000/auth/callback
# OAUTH_STATE_TTL_SECONDS=600
# OAUTH_EXCHANGE_CODE_TTL_SECONDS=60
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=
# OAUTH_GOOGLE_REDIRECT_URI=http://localhost:8000/auth/oauth/google/callback
# OAUTH_GOOGLE_DISCOVERY_URL=https://accounts.google.com/.well-known/openid-configuration
# OAUTH_GOOGLE_SCOPES=openid email profile
# OAUTH_FACEBOOK_CLIENT_ID=
# OAUTH_FACEBOOK_CLIENT_SECRET=
# OAUTH_FACEBOOK_REDIRECT_URI=http://localhost:8000/auth/oauth/facebook/callback
# OAUTH_MICROSOFT_CLIENT_ID=
# OAUTH_MICROSOFT_CLIENT_SECRET=
# OAUTH_MICROSOFT_REDIRECT_URI=http://localhost:8000/auth/oauth/microsoft/callback
# OAUTH_GITHUB_CLIENT_ID=
# OAUTH_GITHUB_CLIENT_SECRET=
# OAUTH_GITHUB_REDIRECT_URI=http://localhost:8000/auth/oauth/github/callback
# Sign in with Apple (Services ID + key). Prefer TEAM_ID/KEY_ID/.p8 over a static secret.
# OAUTH_APPLE_CLIENT_ID=
# OAUTH_APPLE_TEAM_ID=
# OAUTH_APPLE_KEY_ID=
# OAUTH_APPLE_PRIVATE_KEY_PATH=keys/AuthKey_XXXXX.p8
# OAUTH_APPLE_PRIVATE_KEY=
# OAUTH_APPLE_CLIENT_SECRET=
# OAUTH_APPLE_REDIRECT_URI=http://localhost:8000/auth/oauth/apple/callback
# OAUTH_APPLE_SCOPES=name email

# Enterprise IdP resource server (accept IdP ****** on the API)
# IDP_RESOURCE_SERVER_ENABLED=false
# IDP_ISSUER=https://login.microsoftonline.com/{tenant}/v2.0
# IDP_AUDIENCE=
# IDP_JWKS_URL=
# IDP_DISCOVERY_URL=
# IDP_ALGORITHMS=RS256
# IDP_PROVIDER_NAME=entra
# IDP_EMAIL_CLAIM=email

# SQL — chat_api owns this database exclusively. Installed extras: sqlite,
# postgres. Selecting `mysql` raises MissingExtraError naming base[mysql].
SQL_BACKEND=sqlite
SQLITE_DB_PATH=database/app.db
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# DB_POOL_TIMEOUT=30
# DB_POOL_RECYCLE=3600
# DB_SSL_ENABLED=true

# PostgreSQL (when SQL_BACKEND=postgresql). Host/port usually come from
# .env.shared; the database name is this service's own.
# PG_DATABASE=chat_db
# POSTGRES_USER=
# POSTGRES_PASSWORD=

# Redis
# REDIS_URL=redis://localhost:6379/0
# REDIS_SSL_CERT_REQS=
# REDIS_MAX_CONNECTIONS=50
# REDIS_SOCKET_TIMEOUT=5.0
# REDIS_SOCKET_CONNECT_TIMEOUT=5.0
# REDIS_RETRY_ON_TIMEOUT=true
# REDIS_HEALTH_CHECK_INTERVAL=30
# REDIS_DECODE_RESPONSES=true

# LLM — this service's own key and model, independent of any other service's.
# OPENAI_LLM_ENDPOINT=
# OPENAI_LLM_MODEL=
# OPENAI_LLM_API_KEY=
# AZURE_OPENAI_API_VERSION=
# AZURE_OPENAI_LLM_ENDPOINT=
# AZURE_OPENAI_LLM_DEPLOYMENT_NAME=
# AZURE_OPENAI_LLM_API_KEY=

# Prompts
LOAD_PROMPTS_FROM_DB=false
