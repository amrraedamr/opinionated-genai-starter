# Credentials for running the suite against live providers.
#
# Copy to `.env` (gitignored) and fill in only the providers you want
# exercised. `CoreSettings` loads `.env.shared` then `.env` then `.env.local`,
# so this file wins over the shared infrastructure template and loses to a
# real process environment.
#
# Leave a key blank to skip that provider rather than fail it. A partial run
# is the normal case: nobody holds credentials for all of these at once.
#
# Local infrastructure is NOT here. Postgres, Redis, Mongo and Qdrant come
# from `deploy/docker-compose.infra.yml` with endpoints in `.env.shared`:
#
#     cp .env.shared.example .env.shared
#     docker compose -f deploy/docker-compose.infra.yml up -d
#
# Nothing in this file belongs in a deployment, where the platform injects
# process environment instead.

# ----------------------------------------------------------------------------
# Language models. One key enables that provider's half of the shared suite.
# ----------------------------------------------------------------------------

OPENAI_LLM_API_KEY=
# Optional. Set to reach a gateway or a compatible server instead of OpenAI.
OPENAI_LLM_ENDPOINT=

AZURE_OPENAI_LLM_API_KEY=
AZURE_OPENAI_LLM_ENDPOINT=

ANTHROPIC_API_KEY=
ANTHROPIC_LLM_ENDPOINT=

GEMINI_API_KEY=
GEMINI_LLM_ENDPOINT=
GEMINI_PROJECT=

# ----------------------------------------------------------------------------
# Embeddings and reranking.
# ----------------------------------------------------------------------------

OPENAI_EMBEDDING_API_KEY=
OPENAI_EMBEDDING_ENDPOINT=

AZURE_OPENAI_EMBEDDING_API_KEY=
AZURE_OPENAI_EMBEDDING_ENDPOINT=

COHERE_API_KEY=

# ----------------------------------------------------------------------------
# Azure-backed storage. Each one is a live resource the suite will write to,
# so point them at something disposable rather than anything that matters.
# ----------------------------------------------------------------------------

AZURE_BLOB_ACCOUNT_URL=
KEYVAULT_URL=

AZURE_COSMOS_ACCOUNT_URI=
AZURE_COSMOS_ACCOUNT_KEY=

AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_API_KEY=

# Qdrant needs no key locally; set one only for Qdrant Cloud.
QDRANT_API_KEY=

# ----------------------------------------------------------------------------
# Login providers. Only needed to exercise the OAuth flows; the rest of the
# identity suite runs without them.
# ----------------------------------------------------------------------------

OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=

OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=

OAUTH_FACEBOOK_CLIENT_ID=
OAUTH_FACEBOOK_CLIENT_SECRET=

OAUTH_APPLE_CLIENT_ID=
OAUTH_APPLE_CLIENT_SECRET=

# A service this library issues its own outbound token to, for the
# client-credentials grant. Leave blank unless testing that path.
OUTBOUND_TOKEN_URL=
OUTBOUND_CLIENT_ID=
OUTBOUND_CLIENT_SECRET=
