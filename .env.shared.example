# Shared LOCAL-DEVELOPMENT infrastructure endpoints, read by every service.
#
# Copy to `.env.shared` (gitignored). It is loaded FIRST, so a service's own
# `.env` overrides anything here, and real process environment beats them both.
#
# This file must never hold a secret that differs per environment. In a
# deployment it does not exist at all — the platform injects process env.

# Where the local containers listen. One engine, one database per service;
# each service sets its own PG_DATABASE / REDIS_URL db index in its own `.env`.
PG_HOST=localhost
PG_PORT=5432
PG_SSL_ROOT_CERT=
DB_SSL_ENABLED=false

REDIS_URL=redis://localhost:6379/0

MONGODB_HOST=localhost
QDRANT_URL=http://localhost:6333

ENVIRONMENT=local
